#!/bin/bash
set -e
echo "Building CCM model and adding to local Maven..."

# Ensure any previous build is clean
mvn clean package -DskipTests

# Path to the built classes
MODEL_JAR="target/classes/ccm-models.jar"

# If Quarkus changed the structure, try fallback location
if [ ! -f "$MODEL_JAR" ]; then
  MODEL_JAR=$(find . -name "ccm-models*.jar" | head -1)
fi

if [ -z "$MODEL_JAR" ] || [ ! -f "$MODEL_JAR" ]; then
  echo "Could not find ccm-models.jar after build!"
  exit 1
fi

echo "Installing $MODEL_JAR into local Maven..."
mvn install:install-file \
  -Dfile="$MODEL_JAR" \
  -DgroupId=ccm \
  -DartifactId=ccm-models \
  -Dversion=0.0.1-SNAPSHOT \
  -Dpackaging=jar

echo "CCM models successfully installed to local Maven."
