#!/bin/bash
set -e

echo "🏗️ Repackaging CCM models using Maven..."

# Step 1 — full compile so dependencies (Jackson, javax.json) are available
mvn -q -e -DskipTests clean package

# Step 2 — verify compiled classes exist
if [ ! -d "target/classes/ccm/models" ]; then
  echo "❌ Models not found in target/classes/ccm/models"
  exit 1
fi

# Step 3 — create jar file EXACTLY where systemPath expects it
mkdir -p target/classes

echo "📦 Creating ccm-models.jar ..."

jar cf target/classes/ccm-models.jar -C target/classes ccm/models -C target/classes ccm/utils

echo "✅ Successfully built target/classes/ccm-models.jar"
ls -lh target/classes/ccm-models.jar
