#!/bin/bash
set -e

echo "🏗️ Repackaging CCM models..."

# Step 1: Compile all Java source files
mvn clean compile -DskipTests

# Step 2: Create the JAR if compilation succeeded
if [ ! -d "target/classes" ]; then
  echo " No compiled classes found. Build failed."
  exit 1
fi

pushd target/classes/ > /dev/null

# Build the jar
jar cvf ccm-models.jar ccm/models/*/*/*.class ccm/models/*/*/*/*.class ccm/utils/*.class || echo "⚠️ Some paths not found (may be OK if empty)"

popd > /dev/null

echo " ccm-models.jar created successfully at target/classes/"
