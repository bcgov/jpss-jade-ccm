#!/bin/bash
set -e

echo "🏗️ Repackaging CCM models..."

# Compile ONLY model classes
mkdir -p target/classes

# Find all model + utils classes
find src/main/java/ccm/models src/main/java/ccm/utils -type f -name "*.java" > target/model_sources.txt

if [ ! -s target/model_sources.txt ]; then
  echo "❌ No model classes found"
  exit 1
fi

echo "📦 Compiling model classes..."
javac --release 17 -d target/classes @target/model_sources.txt

echo "📦 Packaging ccm-models.jar..."
jar cf target/classes/ccm-models.jar -C target/classes ccm/models -C target/classes ccm/utils

echo "✅ ccm-models.jar built at: target/classes/ccm-models.jar"
ls -lh target/classes/ccm-models.jar
