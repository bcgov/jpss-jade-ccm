#!/bin/bash
set -e

echo "🏗️ Repackaging CCM models..."

# Compile everything in the repo
mvn -q clean compile -DskipTests

echo "📦 Creating ccm-models.jar ..."

mkdir -p target/classes

# Find all .class files in the whole repository under any "models" folder
find . -type f -path "*/models/**/*.class" > /tmp/classlist.txt

if [ ! -s /tmp/classlist.txt ]; then
  echo "❌ No model classes found! Cannot build ccm-models.jar"
  exit 1
fi

# Build JAR with model classes
jar cf target/classes/ccm-models.jar \
    -C . $(sed "s|^\./||" /tmp/classlist.txt)

echo "✅ ccm-models.jar created → target/classes/ccm-models.jar"
ls -lh target/classes/ccm-models.jar
